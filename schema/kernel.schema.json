{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devkit.local/schema/kernel.schema.json",
  "title": "DevKit kernel manifest (kernel/kernel.json)",
  "description": "SPEC.md sections 3 and 6: the kernel's version, its services and where its public surface is.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "spec", "status", "services", "permissions", "public_api", "source"],
  "properties": {
    "$schema": {"type": "string"},
    "id": {"const": "kernel"},
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "spec": {"type": "string", "pattern": "^\\d+\\.\\d+$"},
    "status": {"enum": ["not built", "experimental", "stable"]},
    "services": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z_]*$"},
      "uniqueItems": true
    },
    "permissions": {
      "description": "SPEC.md 14.8: the kernel's own permissions, as a module's manifest declares its. The owner role holds every permission; default_roles are the others that get it at install (the auth migration's seed, which a test holds to this list).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "description", "default_roles"],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^(auth|kernel)\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
          },
          "description": {"type": "string", "minLength": 3},
          "default_roles": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        }
      }
    },
    "public_api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "web"],
      "properties": {"backend": {"type": "string"}, "web": {"type": "string"}}
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "commit", "license"],
      "properties": {
        "from": {"type": "string"},
        "commit": {"type": "string"},
        "license": {"type": "string"}
      }
    }
  }
}
