{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devkit.local/schema/recipe.schema.json",
  "title": "DevKit recipe",
  "description": "SPEC.md section 17: a preset list of modules and settings for one kind of site.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "fits",
    "modules",
    "settings",
    "theme"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "fits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "settings": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9_]*$"
      }
    },
    "theme": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    }
  }
}
