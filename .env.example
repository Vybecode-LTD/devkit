# The harness's settings for local runs. Copy to .env and fill in.
# Generate SECRET_KEY with:   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Generate ENCRYPTION_KEYS with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEYS takes several keys, comma-separated, newest first, so keys rotate.
DEBUG=true
SITE_URL=http://localhost:8000
# The built web app's folder, whose index.html (with its page-head and page-body
# markers) every public address answers with (kernel.shell, decision 0041).
# Blank: the kernel's minimal shell, with no scripts.
WEB_DIST=
DATABASE_URL=postgresql://mechframe:mechframe@localhost:5432/mechframe
SECRET_KEY=
ENCRYPTION_KEYS=
# Which modules this deploy may use, comma-separated; * for every installed module.
MODULES=*
SENTRY_DSN=
# Mail (kernel.email, decision 0033): nothing set sends nothing. SMTP comes first: set
# SMTP_HOST and its login. MAIL_FROM is one bare address; MAIL_FROM_NAME defaults to SITE_NAME.
MAIL_FROM=
MAIL_FROM_NAME=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Only on a host that blocks outbound SMTP (Railway's Hobby plan): leave SMTP_HOST blank
# and set Resend's key instead.
RESEND_API_KEY=
# Storage (kernel.storage, decision 0032): blank is off. All four of the first
# group, or none; the public pair together. R2's endpoint is
# https://<account>.r2.cloudflarestorage.com; a local S3 server on http works with DEBUG on.
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_BUCKET=
STORAGE_PUBLIC_URL=
LOG_FORMAT=text

# --- Jobs (kernel.jobs, decision 0035) ---
# true: the web process runs the jobs worker (one service). A site that runs
# its own worker service (python -m app.worker), for heavy jobs such as
# ffmpeg, sets false here on the web service.
JOBS_IN_WEB=true
# Jobs a worker runs at once, how often it looks for due ones (seconds), and
# how long SIGTERM gives running jobs before leaving them to their leases.
JOBS_CONCURRENCY=4
JOBS_POLL_SECONDS=1
JOBS_DRAIN_SECONDS=20

# --- Audit log (kernel.audit, decision 0037) ---
# Days an entry is kept before the nightly pruning removes it (at least 30).
AUDIT_KEEP_DAYS=365
