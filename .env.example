# The harness's settings for local runs. Copy to .env and fill in.
# Generate SECRET_KEY with:   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Generate ENCRYPTION_KEYS with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEYS takes several keys, comma-separated, newest first, so keys rotate.
DEBUG=true
SITE_URL=http://localhost:8000
DATABASE_URL=postgresql://devkit:devkit@localhost:5432/devkit
SECRET_KEY=
ENCRYPTION_KEYS=
# Which modules this deploy may use, comma-separated; * for every installed module.
MODULES=*
SENTRY_DSN=
LOG_FORMAT=text
