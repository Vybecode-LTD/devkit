# Every setting this site reads, with its live value or a blank to fill. On Railway
# they're the service's variables, typed by the site's owner (never committed).
# For local work, copy this file to .env and change three lines: DEBUG=true,
# SITE_URL=http://localhost:8000 and CLIENT_IP_HEADER= (blank: no proxy locally).
#
# Generate SECRET_KEY with:      python -c "import secrets; print(secrets.token_urlsafe(48))"
# Generate ENCRYPTION_KEYS with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEYS takes several keys, comma-separated, newest first, so keys rotate.
DEBUG=false
SITE_NAME=__SITE_NAME__
SITE_URL=
DATABASE_URL=postgresql://site:site@localhost:5432/site
SECRET_KEY=
ENCRYPTION_KEYS=
# The built web app, whose index.html every public address answers with (SPEC.md
# section 9): web/dist after `npm run build`. The Dockerfile sets /app/web/dist.
WEB_DIST=web/dist
# Which modules this deploy may use, comma-separated; * for every module the site has.
MODULES=*
SENTRY_DSN=

# --- Behind Railway's edge (K5 contract, the owner's answer 3) ---
# The header the edge writes with the visitor's address, for rate limits and the audit log.
CLIENT_IP_HEADER=X-Real-IP
# Whose X-Forwarded-* headers uvicorn trusts (the Dockerfile's start command). 127.0.0.1
# here; * on Railway, whose edge has no fixed addresses and is the only way in.
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Mail (kernel.email, decision 0033): nothing set sends nothing ---
# SMTP comes first: set SMTP_HOST and its login. MAIL_FROM is one bare address;
# MAIL_FROM_NAME defaults to SITE_NAME.
MAIL_FROM=
MAIL_FROM_NAME=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Only on a host that blocks outbound SMTP (Railway's Hobby plan): leave SMTP_HOST blank
# and set Resend's key instead.
RESEND_API_KEY=

# --- Storage (kernel.storage, decision 0032): blank is off ---
# All four of the first group, or none; the public pair together. R2's endpoint is
# https://<account>.r2.cloudflarestorage.com.
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_BUCKET=
STORAGE_PUBLIC_URL=
LOG_FORMAT=json

# --- Jobs (kernel.jobs, decision 0035) ---
# true: the web process runs the jobs worker (one service). A site that runs its own
# worker service (python -m app.worker), for heavy jobs, sets false on the web service.
JOBS_IN_WEB=true
JOBS_CONCURRENCY=4
JOBS_POLL_SECONDS=1
JOBS_DRAIN_SECONDS=20

# --- Audit log (kernel.audit, decision 0037) ---
# Days an entry is kept before the nightly pruning removes it (at least 30).
AUDIT_KEEP_DAYS=365

# --- Sign-up and the edge ---
# Who may make an account: open, invite or closed. Once the site is up, Admin, Settings
# holds it (kernel.auth); this is its first value.
SIGN_UP_MODE=closed
# Other sites allowed to call this one's API, comma-separated; blank for none.
CORS_ORIGINS=
# Strict-Transport-Security's max-age in seconds: 0 sends none. 31536000 once the
# domain is settled and every part of it is on https.
HSTS_MAX_AGE=0
# true on a copy that no search engine should list, a staging site.
ROBOTS_NOINDEX=false
SENTRY_ENVIRONMENT=
LOG_LEVEL=INFO

# --- Tuning: the kernel's defaults, changed only with a reason ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
MODULES_CACHE_SECONDS=5
MAX_BODY_BYTES=1048576
STORAGE_REGION=auto
STORAGE_MAX_BYTES=2147483648
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE=memory://
# Password hashing (Argon2id): its memory, passes and lanes, and how many run at once.
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_LANES=4
ARGON2_CONCURRENCY=4

# --- The modules' settings, appended by mechframe add ---
