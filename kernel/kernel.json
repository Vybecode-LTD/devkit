{
  "id": "kernel",
  "version": "0.1.0-dev.0",
  "spec": "0.1",
  "status": "experimental",
  "services": [
    "auth",
    "users",
    "roles",
    "settings",
    "database",
    "email",
    "notifications",
    "storage",
    "events",
    "jobs",
    "moderation",
    "audit",
    "security",
    "crypto",
    "rate_limit",
    "modules"
  ],
  "permissions": [
    {
      "key": "auth.user.manage",
      "description": "See and edit people's accounts",
      "default_roles": [
        "admin"
      ]
    },
    {
      "key": "auth.user.suspend",
      "description": "Suspend and restore accounts",
      "default_roles": [
        "admin"
      ]
    },
    {
      "key": "auth.role.assign",
      "description": "Grant and remove roles, within the permissions you hold",
      "default_roles": [
        "admin"
      ]
    },
    {
      "key": "auth.role.manage",
      "description": "Create, edit and delete roles, within the permissions you hold",
      "default_roles": [
        "admin"
      ]
    },
    {
      "key": "auth.audit.read",
      "description": "Read the audit log",
      "default_roles": [
        "admin"
      ]
    },
    {
      "key": "kernel.module.manage",
      "description": "Switch modules on and off",
      "default_roles": [
        "admin"
      ]
    },
    {
      "key": "kernel.settings.manage",
      "description": "Change any module's settings",
      "default_roles": [
        "admin"
      ]
    },
    {
      "key": "kernel.jobs.manage",
      "description": "Retry and discard failed background jobs",
      "default_roles": [
        "admin"
      ]
    },
    {
      "key": "kernel.moderation.act",
      "description": "Act on moderation reports: hide, delete, time out and ban",
      "default_roles": [
        "admin",
        "editor"
      ]
    },
    {
      "key": "kernel.taxonomy.manage",
      "description": "Add, rename, move and delete the site's terms",
      "default_roles": [
        "admin",
        "editor"
      ]
    }
  ],
  "pages": [
    {
      "path": "/sign-in",
      "title": "Sign in",
      "access": "public"
    },
    {
      "path": "/sign-up",
      "title": "Sign up",
      "access": "public"
    },
    {
      "path": "/forgot-password",
      "title": "Forgot password",
      "access": "public"
    },
    {
      "path": "/auth/verify",
      "title": "Verify your email",
      "access": "public"
    },
    {
      "path": "/auth/link",
      "title": "Sign in with a link",
      "access": "public"
    },
    {
      "path": "/auth/reset",
      "title": "Choose a new password",
      "access": "public"
    },
    {
      "path": "/auth/email",
      "title": "Confirm your new email",
      "access": "public"
    },
    {
      "path": "/auth/email/undo",
      "title": "Undo the email change",
      "access": "public"
    },
    {
      "path": "/auth/second-factor/undo",
      "title": "Remove the new sign-in step",
      "access": "public"
    },
    {
      "path": "/notifications/unsubscribe",
      "title": "Unsubscribe",
      "access": "public"
    },
    {
      "path": "/account",
      "title": "Your account",
      "access": "member"
    },
    {
      "path": "/account/notifications",
      "title": "Notifications",
      "access": "member"
    },
    {
      "path": "/account/activity",
      "title": "Your activity",
      "access": "member"
    },
    {
      "path": "/admin",
      "title": "Dashboard",
      "access": "admin"
    },
    {
      "path": "/admin/people",
      "title": "People",
      "access": "admin"
    },
    {
      "path": "/admin/roles",
      "title": "Roles",
      "access": "admin"
    },
    {
      "path": "/admin/activity",
      "title": "Activity",
      "access": "admin"
    },
    {
      "path": "/admin/settings",
      "title": "Settings",
      "access": "admin"
    },
    {
      "path": "/admin/settings/features",
      "title": "Features",
      "access": "admin"
    },
    {
      "path": "/admin/settings/system",
      "title": "System",
      "access": "admin"
    }
  ],
  "public_api": {
    "backend": "backend/kernel/__init__.py",
    "web": "web/index.ts"
  },
  "source": {
    "from": "VybeSite (plus Basefra.me OAuth, VybeMindz patterns)",
    "commit": "TBD at extraction",
    "license": "proprietary"
  }
}
